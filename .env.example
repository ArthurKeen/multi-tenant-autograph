# =============================================================================
# Multi-Tenant GraphRAG Isolation Prototype -- environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# MUST NOT be committed (it will hold prod demo cluster URLs and a JWT).
#
# NOTE on Vite: only variables prefixed with `VITE_` are exposed to the browser
# bundle. The demo JWT below is therefore visible client-side -- acceptable for
# a short-lived demo token against a demo cluster, but never use a long-lived or
# privileged token here.
# =============================================================================

# --- Backend service base URLs (prod demo cluster) ---------------------------
# AutoGraph Go gRPC-Gateway REST endpoint (ingest / build / strategize / orchestrate)
VITE_AUTOGRAPH_BASE_URL=https://autograph.demo.example.com

# GraphRAG Retrievers REST endpoint (chat / query-stream)
VITE_RETRIEVERS_BASE_URL=https://retrievers.demo.example.com

# --- Auth --------------------------------------------------------------------
# Bearer JWT used for all backend calls (validated by the platform auth service).
# Use a short-lived demo token with access only to the demo database.
VITE_DEMO_JWT=

# --- Project / database scoping ----------------------------------------------
# GENAI_PROJECT_NAME the backend was deployed with; prefixes collection names.
VITE_GENAI_PROJECT_NAME=multitenant_demo

# --- Tenant -> module mapping ------------------------------------------------
# The `module` value sent on import for each tenant persona. Keep disjoint.
VITE_TENANT_A_MODULE=tenant_a
VITE_TENANT_B_MODULE=tenant_b
VITE_TENANT_C_MODULE=tenant_c

# Human-readable labels shown in the tenant selector (no customer names).
VITE_TENANT_A_LABEL=Tenant A
VITE_TENANT_B_LABEL=Tenant B
VITE_TENANT_C_LABEL=Tenant C

# --- Ingestion / build defaults ----------------------------------------------
VITE_EMBEDDING_STRATEGY=openai

# --- Build polling -----------------------------------------------------------
VITE_BUILD_POLL_INTERVAL_MS=3000
VITE_BUILD_POLL_TIMEOUT_MS=600000
